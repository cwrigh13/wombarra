{
  "name": "wombarra-backend",
  "version": "1.0.0",
  "description": "Express proxy that ingests GTFS-Realtime Sydney Trains data, filters to Wombarra region, and serves simplified JSON.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gtfs-realtime-bindings": "^1.1.1",
    "node-fetch": "^2.7.0"
  }
}
